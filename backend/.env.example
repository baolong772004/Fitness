PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
DATABASE_URL="sqlserver://localhost:1433;database=fitness_db;integratedSecurity=true;trustServerCertificate=true"

# PayOS is required for checkout creation and webhook verification.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Browser redirect targets after a customer completes or cancels payment.
FRONTEND_URL=http://localhost:5173

# Create an API key in Google AI Studio. Never put this key in the frontend .env file.
GEMINI_API_KEY=
# Optional: Gemini model available to your AI Studio account.
GEMINI_MODEL=gemini-3.5-flash-lite

# Private computer-vision service. Configure the same random key in ai-exercise-service.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_KEY=
# Set true only in a local development environment to enable the separate
# Developer/Coach experimental evaluation endpoint. Never enable in production.
AI_EXPERIMENTAL_EVALUATION=false
AI_FORM_MEMBER_24H_LIMIT=3
AI_FORM_TRIAL_24H_LIMIT=5
AI_FORM_PT_24H_LIMIT=10
