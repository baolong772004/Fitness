PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
DATABASE_URL="sqlserver://USER:PASSWORD@localhost:1433;database=fitness_db;encrypt=true;trustServerCertificate=true"

# PT chat messages are stored in MongoDB. Point this at MongoDB Community or Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/fitness_db
# Optional when the database name is already in MONGODB_URI.
# MONGODB_DB=fitness_db

# PayOS is required for checkout creation and webhook verification.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Browser redirect targets after a customer completes or cancels payment.
FRONTEND_URL=http://localhost:5173
