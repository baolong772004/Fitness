datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. NGƯỜI DÙNG & PHÂN QUYỀN (USER & ROLES)
// ==========================================

model User {
  id          Int        @id @default(autoincrement())
  email       String     @unique
  password    String
  mustChangePassword Boolean @default(false)
  fullName    String
  phone       String?
  avatar      String?
  gender      String?
  dateOfBirth DateTime?
  height      Float?     
  weight      Float?
  role        String     @default("MEMBER")
  status      String     @default("PENDING")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  memberships       Membership[]
  checkIns          CheckIn[]          @relation("MemberCheckIns")
  memberBookings    Booking[]          @relation("MemberBookings")
  workoutPlans      WorkoutPlan[]      @relation("MemberWorkoutPlans")
  studentWorkoutPlans StudentWorkoutPlan[] @relation("StudentWorkoutPlanMember")
  assignedWorkoutPlans StudentWorkoutPlan[] @relation("StudentWorkoutPlanCoach")
  workoutPlanRevisions WorkoutPlanRevision[] @relation("WorkoutPlanRevisionEditor")
  progressLogs      ProgressLog[]
  ptAssessmentsAsMember PtTrainingAssessment[] @relation("PtAssessmentMember")
  ptAssessmentsAsCoach PtTrainingAssessment[] @relation("PtAssessmentCoach")
  payments          Payment[]
  givenReviews      Review[]           @relation("MemberReviews")
  supportRequests   SupportRequest[]   @relation("MemberSupport")
  sentPtChatMessages PtChatMessage[]    @relation("PtChatSender")
  ptWallet          PtWallet?

  coachProfile      CoachProfile?
  coachBookings     Booking[]          @relation("CoachBookings")
  groupClasses      GroupClassSchedule[] @relation("CoachClasses")
  groupClassBookings GroupClassBooking[]
  createdPlans      WorkoutPlan[]      @relation("CoachCreatedPlans")
  trainerMemberships Membership[]      @relation("TrainerMemberships")

  actionLogs        ActionLog[]
  processedSupports SupportRequest[]   @relation("StaffSupport")
  handledCheckIns   CheckIn[]          @relation("StaffCheckIns")
  staffShifts       StaffShift[]       @relation("StaffShifts")
  staffOperationalNotes OperationalNote[] @relation("StaffOperationalNotes")
  consultantPayments Payment[]         @relation("ConsultantPayments")
  staffPayments     Payment[]          @relation("StaffProcessedPayments")
  exerciseAnalyses   ExerciseAnalysis[]
  exerciseAnalysisShares ExerciseAnalysisSharing[] @relation("ExerciseShareCoach")
  exerciseAnalysisFeedback ExerciseAnalysisFeedback[] @relation("ExerciseFeedbackCoach")
  exerciseTechniqueLabels ExerciseTechniqueCoachLabel[] @relation("ExerciseTechniqueLabelCoach")
  exerciseCriterionReviews ExerciseTechniqueCriterionReview[] @relation("ExerciseCriterionReviewer")
}

model ExerciseAnalysis {
  id              Int       @id @default(autoincrement())
  memberId        Int
  member          User      @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exerciseType    String    @db.VarChar(30)
  mediaStorageKey String?   @db.VarChar(100)
  mediaDeletedAt  DateTime?
  studentPlanId   Int?
  studentPlan     StudentWorkoutPlan? @relation(fields: [studentPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status          String    @default("PENDING") @db.VarChar(30)
  evaluationMode  String    @default("OFFICIAL") @db.VarChar(20)
  videoOrigin     String    @default("UNVERIFIED_LEGACY") @db.VarChar(20)
  captureMethodDeclared String @default("UNKNOWN") @db.VarChar(20)
  performerDeclaration String @default("UNKNOWN") @db.VarChar(20)
  videoSha256     String?   @db.VarChar(64)
  sourceReference String?   @db.VarChar(100)
  sessionGroupId  String?   @db.VarChar(36)
  samePersonSessionConfirmed Boolean @default(false)
  resultJson      String?   @db.NVarChar(Max)
  modelVersion    String?   @db.VarChar(100)
  ruleVersion     String?   @db.VarChar(30)
  resultVersion   String?   @db.VarChar(30)
  errorCode       String?   @db.VarChar(60)
  attempts        Int       @default(0)
  startedAt       DateTime?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  shares          ExerciseAnalysisSharing[]
  feedback        ExerciseAnalysisFeedback[]
  techniqueLabels ExerciseTechniqueCoachLabel[]

  @@index([memberId, createdAt])
  @@index([status, createdAt])
  @@index([memberId, sessionGroupId])
}

model ExerciseAnalysisSharing {
  id         Int       @id @default(autoincrement())
  analysisId Int
  analysis   ExerciseAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coachId    Int
  coach      User      @relation("ExerciseShareCoach", fields: [coachId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sharedAt   DateTime  @default(now())
  revokedAt  DateTime?
  includeVideo Boolean @default(false)

  @@unique([analysisId, coachId])
  @@index([coachId, revokedAt, sharedAt])
}

model ExerciseAnalysisFeedback {
  id         Int       @id @default(autoincrement())
  analysisId Int
  analysis   ExerciseAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coachId    Int
  coach      User      @relation("ExerciseFeedbackCoach", fields: [coachId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  comment    String    @db.NVarChar(1000)
  createdAt  DateTime  @default(now())

  @@index([analysisId, createdAt])
}

model ExerciseTechniqueCoachLabel {
  id                Int      @id @default(autoincrement())
  analysisId        Int
  analysis          ExerciseAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  coachId           Int
  coach             User     @relation("ExerciseTechniqueLabelCoach", fields: [coachId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  videoSha256       String   @db.VarChar(64)
  exerciseVariant   String   @db.VarChar(40)
  standardVersion   String   @db.VarChar(100)
  criterionId       String   @db.VarChar(40)
  outcome           String   @db.VarChar(30)
  repNumber         Int?
  startSeconds      Float
  endSeconds        Float
  timestampSeconds Float?
  evidenceJson      String   @db.NVarChar(Max)
  reviewerNotes     String   @db.NVarChar(2000)
  createdAt         DateTime @default(now())

  @@index([analysisId, criterionId, startSeconds])
  @@index([coachId, createdAt])
}

model ExerciseTechniqueCriterionReview {
  id                 Int      @id @default(autoincrement())
  coachId            Int
  coach              User     @relation("ExerciseCriterionReviewer", fields: [coachId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exerciseType       String   @db.VarChar(30)
  exerciseVariant    String   @db.VarChar(40)
  standardVersion    String   @db.VarChar(100)
  standardDigest     String   @db.VarChar(64)
  criterionId        String   @db.VarChar(40)
  decision           String   @db.VarChar(50)
  qualification      String   @db.NVarChar(300)
  reviewRecordId     String   @db.VarChar(100)
  reviewScope        String   @db.NVarChar(1000)
  approvedConditions String   @db.NVarChar(Max)
  measurementFormula String   @db.NVarChar(2000)
  thresholdsJson     String   @db.NVarChar(Max)
  cameraViewsJson    String   @db.NVarChar(Max)
  limitationsJson    String   @db.NVarChar(Max)
  correctionAdvice   String   @db.NVarChar(Max)
  status             String   @default("COACH_REVIEWED_PENDING_VIDEO_VALIDATION") @db.VarChar(60)
  validationReportSha256 String? @db.VarChar(64)
  validationReportPath String? @db.NVarChar(500)
  approvalSignatureSha256 String? @db.VarChar(64)
  approvalScopeJson String? @db.NVarChar(Max)
  releasedStandardDigest String? @db.VarChar(64)
  approvedAt         DateTime?
  reviewedAt         DateTime @default(now())

  @@index([exerciseType, exerciseVariant, standardVersion, criterionId, status])
  @@index([coachId, reviewedAt])
}

model CoachProfile {
  id             Int      @id @default(autoincrement())
  userId         Int      @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bio            String?  @db.NVarChar(Max)
  specialization String?  
  experience     Int?     
  certifications String?
  rating         Float    @default(5.0)
  hourlyRate     Decimal  @default(0) @db.Decimal(18, 2)
  rank           String   @default("senior")
  commissionPercent Int   @default(45)
  status         String   @default("ACTIVE") // ACTIVE | BLOCKED | INACTIVE
  createdAt      DateTime @default(now())

  pricing        CoachPricing[]
  specializations CoachSpecialization[]
  schedules      CoachSchedule[]
  dateAvailability CoachDateAvailability[]
  reviews        Review[]
}

model CoachPricing {
  id             Int          @id @default(autoincrement())
  coachProfileId Int
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sessionCount   Int          
  price          Decimal      @db.Decimal(18, 2)
  createdAt      DateTime     @default(now())
}

model CoachSpecialization {
  coachProfileId Int
  level          String       @db.VarChar(20)
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([coachProfileId, level])
}

model CoachSchedule {
  id             Int          @id @default(autoincrement())
  coachProfileId Int
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  dayOfWeek      Int          
  startTime      String       
  endTime        String       
  isAvailable    Boolean      @default(true)
}

model GymCalendarConfig {
  id           Int      @id
  openTime     String   @default("06:00") @db.VarChar(5)
  closeTime    String   @default("22:00") @db.VarChar(5)
  slotMinutes  Int      @default(60)
  breakMinutes Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model GymClosure {
  id        Int      @id @default(autoincrement())
  startAt   DateTime
  endAt     DateTime
  kind      String   @db.VarChar(20)
  reason    String   @db.NVarChar(500)
  createdAt DateTime @default(now())

  @@index([startAt, endAt])
}

model CoachDateAvailability {
  id             Int          @id @default(autoincrement())
  coachProfileId Int
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  date           String       @db.VarChar(10)
  shifts         String       @db.NVarChar(Max)
  updatedAt      DateTime     @updatedAt

  @@unique([coachProfileId, date])
}

model CoachScheduleChangeRequest {
  id          Int       @id @default(autoincrement())
  coachId     Int
  bookingId   Int
  reason      String    @db.NVarChar(500)
  status      String    @default("PENDING") @db.VarChar(20)
  handledById Int?
  adminNote   String?   @db.NVarChar(500)
  createdAt   DateTime  @default(now())
  handledAt   DateTime?

  @@index([status, createdAt])
  @@index([bookingId, status])
}

// ==========================================
// 2. GÓI TẬP & THÀNH VIÊN (PACKAGES & MEMBERSHIPS)
// ==========================================

model Package {
  id              Int          @id @default(autoincrement())
  name            String
  type            String       @default("MEMBERSHIP") // "MEMBERSHIP" hoặc "PT"
  description     String?      @db.NVarChar(Max)
  price           Decimal      @db.Decimal(18, 2)
  durationDays    Int          // Số ngày sử dụng (ví dụ 30 ngày)
  trialPtSessions Int          @default(0) // Số buổi tập PT tặng kèm (Dành cho gói MEMBERSHIP)
  totalPtSessions Int?         // Tổng số buổi PT mua riêng (Dành cho gói PT)
  ptLevel         String?      @db.VarChar(20) // BEGINNER | INTERMEDIATE | ADVANCED; legacy rows require mapping
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  memberships  Membership[]
  ptProducts   PtProduct[]
}

model PtProduct {
  id           Int      @id @default(autoincrement())
  name         String   @db.NVarChar(100)
  level        String   @db.VarChar(20)
  sessionCount Int
  durationDays Int?
  price        Decimal  @db.Decimal(18, 2)
  singleSessionPrice Decimal? @db.Decimal(18, 2)
  benefits     String?  @db.NVarChar(1000)
  isActive     Boolean  @default(true)
  packageId    Int?
  package      Package? @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments     Payment[]
  purchaseItems PtPurchaseItem[]
  renewalOptions PtRenewalOption[]
  renewalPayments Payment[] @relation("PtRenewalProduct")
}

model PtSingleOffer {
  id           Int     @id @default(autoincrement())
  level        String  @unique @db.VarChar(20)
  price        Decimal @db.Decimal(18, 2)
  durationDays Int
  maxQuantity  Int     @default(20)
  benefits     String? @db.NVarChar(1000)
  isActive     Boolean @default(true)
}

model PtPurchaseItem {
  id               Int     @id @default(autoincrement())
  paymentId        Int
  payment          Payment @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  productId        Int?
  product          PtProduct? @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  mode             String  @db.VarChar(20)
  nameSnapshot     String  @db.NVarChar(100)
  levelSnapshot    String  @db.VarChar(20)
  sessionsSnapshot Int
  durationDays     Int
  unitPrice        Decimal @db.Decimal(18, 2)
  quantity         Int
  benefitsSnapshot String? @db.NVarChar(1000)
  unitStartIndex   Int

  @@unique([paymentId, unitStartIndex])
}

model PtRenewalOption {
  id           Int      @id @default(autoincrement())
  name         String   @db.NVarChar(100)
  level        String   @db.VarChar(20)
  durationDays Int
  price        Decimal  @db.Decimal(18, 2)
  isActive     Boolean  @default(true)
  ptProductId  Int?
  purchaseMode String? @db.VarChar(20)
  ptProduct    PtProduct? @relation(fields: [ptProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments     Payment[]

  @@index([ptProductId])
}

model PtWallet {
  id        Int       @id @default(autoincrement())
  memberId  Int       @unique
  member    User      @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt DateTime  @default(now())
  batches   PtCreditBatch[]
}

model PtCreditBatch {
  id           Int       @id @default(autoincrement())
  walletId     Int
  wallet       PtWallet  @relation(fields: [walletId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  level        String    @db.VarChar(20)
  source       String    @db.VarChar(30)
  initialCount Int
  usedCount    Int       @default(0)
  heldCount    Int       @default(0)
  paymentId    Int?
  payment      Payment?  @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseUnitIndex Int @default(0)
  ptProductIdSnapshot Int?
  benefitsSnapshot String? @db.NVarChar(1000)
  membershipId Int?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coachId      Int?
  grantedAt    DateTime  @default(now())
  startAt      DateTime?
  endAt        DateTime?
  activatedAt  DateTime?
  allocations  PtBookingCreditAllocation[]
  transactions PtCreditTransaction[]
  renewalPayments Payment[] @relation("PtBatchRenewals")
  renewalEvents PtRenewalEvent[]
  coachChangeRequests PtCoachChangeRequest[]

  @@index([walletId, level, grantedAt])
  @@index([walletId, level, endAt])
}

model PtCoachChangeRequest {
  id            Int      @id @default(autoincrement())
  batchId       Int
  batch         PtCreditBatch @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberId      Int
  oldCoachId    Int
  newCoachId    Int
  reason        String   @db.NVarChar(500)
  status        String   @default("PENDING_ADMIN") @db.VarChar(20)
  quotaExempt   Boolean  @default(false)
  handledById   Int?
  adminNote     String?  @db.NVarChar(500)
  requestedAt   DateTime @default(now())
  handledAt     DateTime?

  @@index([memberId, requestedAt])
  @@index([status, requestedAt])
  @@index([batchId, status])
}

model PtBookingCreditAllocation {
  bookingId Int @id
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  batchId   Int
  batch     PtCreditBatch @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status    String @default("HELD") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId, status])
}

model PtCreditTransaction {
  id        Int @id @default(autoincrement())
  batchId   Int
  batch     PtCreditBatch @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookingId Int?
  kind      String @db.VarChar(30)
  quantity  Int
  actorId   Int?
  note      String? @db.NVarChar(500)
  createdAt DateTime @default(now())

  @@index([batchId, createdAt])
  @@index([bookingId])
}

model PtRenewalEvent {
  id             Int           @id @default(autoincrement())
  batchId        Int
  batch          PtCreditBatch @relation(fields: [batchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paymentId      Int           @unique
  payment        Payment       @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  previousEndAt  DateTime
  startAt        DateTime
  endAt          DateTime
  durationDays   Int
  createdAt      DateTime      @default(now())

  @@index([batchId, createdAt])
}

model Membership {
  id                Int        @id @default(autoincrement())
  userId            Int
  user              User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  packageId         Int
  package           Package    @relation(fields: [packageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  startDate         DateTime
  endDate           DateTime
  remainingSessions Int?       
  maxMakeupAllowed  Int        @default(3)
  usedMakeupCount   Int        @default(0)
  isGymMembership   Boolean    @default(false)
  activationOrder   Int?
  activatedAt       DateTime?
  status            String     @default("PENDING")
  coachId           Int?
  coach             User?      @relation("TrainerMemberships", fields: [coachId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  payments          Payment[]
  bookings          Booking[]
  checkIns          CheckIn[]
  ptCreditBatches   PtCreditBatch[]
}

// ==========================================
// 3. PHÒNG TẬP & THIẾT BỊ (ROOMS & EQUIPMENT)
// ==========================================

model Room {
  id          Int          @id @default(autoincrement())
  name        String       
  type        String       
  capacity    Int
  isActive    Boolean      @default(true)

  equipments  Equipment[]
  checkIns    CheckIn[]
  schedules   GroupClassSchedule[]
}

model Equipment {
  id        Int             @id @default(autoincrement())
  name      String
  code      String          @unique
  roomId    Int
  room      Room            @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status    String          @default("AVAILABLE")
  note      String?
}

// ==========================================
// 4. LỚP HỌC NHÓM (GROUP CLASSES)
// ==========================================

model GroupClass {
  id          Int                 @id @default(autoincrement())
  name        String              @db.NVarChar(100)
  description String?             @db.NVarChar(500)
  imageUrl    String?             @db.VarChar(255)
  durationMin Int                 @default(60) // Thời lượng buổi học (phút)
  schedules   GroupClassSchedule[]
  createdAt   DateTime            @default(now())
}

model GroupClassSchedule {
  id          Int                     @id @default(autoincrement())
  classId     Int
  trainerId   Int                     // HLV đứng lớp
  roomId      Int?                    // Trỏ về Room trong DB
  startTime   DateTime
  endTime     DateTime
  capacity    Int                     @default(20) // Sức chứa tối đa (VD: 20 người)
  bookedCount Int                     @default(0)  // Số lượng đã đăng ký hiện tại
  status      String                  @default("OPEN") // OPEN | FULL | CANCELLED | COMPLETED
  
  // Relations
  groupClass  GroupClass              @relation(fields: [classId], references: [id])
  trainer     User                    @relation("CoachClasses", fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  room        Room?                   @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookings    GroupClassBooking[]

  @@index([startTime])
  @@index([classId])
}

model GroupClassBooking {
  id          Int                @id @default(autoincrement())
  scheduleId  Int
  userId      Int
  status      String             @default("BOOKED") // BOOKED | CHECKED_IN | CANCELLED
  createdAt   DateTime           @default(now())

  // Relations
  schedule    GroupClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  user        User               @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([scheduleId, userId]) // Một Member chỉ đăng ký 1 lần cho 1 lịch học
}

// ==========================================
// 5. ĐẶT LỊCH, HỌC BÙ & BUỔI TẬP (BOOKING & MAKE-UP)
// ==========================================

model Booking {
  id            Int           @id @default(autoincrement())
  type          String
  memberId      Int
  member        User          @relation("MemberBookings", fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coachId       Int?
  coach         User?         @relation("CoachBookings", fields: [coachId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membershipId  Int?
  membership    Membership?   @relation(fields: [membershipId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  startTime     DateTime
  endTime       DateTime
  status        String        @default("UPCOMING")
  sessionQrToken String?      @db.NVarChar(Max)
  
  reportedAbsence Boolean     @default(false)
  absenceReason   String?
  absenceReportedAt DateTime?
  cancelledBy     String?
  isMakeup        Boolean       @default(false)
  makeupFromId    Int?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  makeUpRequests     MakeUpRequest[] @relation("OriginalBooking")
  createdFromMakeUp  MakeUpRequest[] @relation("NewBooking")
  sessionResult      SessionResult?
  review             Review?
  ptChatMessages     PtChatMessage[]
  ptCreditAllocation PtBookingCreditAllocation?
}

model PtChatMessage {
  id        Int      @id @default(autoincrement())
  bookingId Int
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  senderId  Int
  sender    User     @relation("PtChatSender", fields: [senderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content   String   @db.NVarChar(1000)
  createdAt DateTime @default(now())

  @@index([bookingId, id])
  @@index([senderId])
}

model MakeUpRequest {
  id                Int          @id @default(autoincrement())
  originalBookingId Int
  originalBooking   Booking      @relation("OriginalBooking", fields: [originalBookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  newBookingId      Int?
  newBooking        Booking?     @relation("NewBooking", fields: [newBookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  status            String       @default("PENDING")
  expiresAt         DateTime     
  rejectReason      String?
  createdAt         DateTime     @default(now())
}

model SessionResult {
  id          Int      @id @default(autoincrement())
  bookingId   Int      @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notes       String?  @db.NVarChar(Max)
  calories    Int?
  durationMin Int?
  createdAt   DateTime @default(now())

  exercises   SessionExercise[]
}

model SessionExercise {
  id              Int           @id @default(autoincrement())
  sessionResultId Int
  sessionResult   SessionResult @relation(fields: [sessionResultId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exerciseName    String
  sets            Int
  reps            Int
  weightKg        Float?
}

// ==========================================
// 6. CHECK-IN VÀO PHÒNG TẬP (Luồng 3 & 20)
// ==========================================

model CheckIn {
  id             Int           @id @default(autoincrement())
  memberId       Int
  member         User          @relation("MemberCheckIns", fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membershipId   Int?
  membership     Membership?   @relation(fields: [membershipId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roomId         Int?
  room           Room?         @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staffId        Int?          
  staff          User?         @relation("StaffCheckIns", fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shiftId        Int?
  shift          StaffShift?   @relation("ShiftCheckIns", fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  checkInTime    DateTime      @default(now())
  method         String        @default("QR_CODE") // QR_CODE / MANUAL
  status         String        @default("SUCCESS")
  rejectReason   String?
}

// ==========================================
// 7. THANH TOÁN & GIAO DỊCH (PAYMENTS)
// ==========================================

model Payment {
  id                  Int           @id @default(autoincrement())
  userId              Int
  user                User          @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  membershipId        Int?
  membership          Membership?   @relation(fields: [membershipId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  amount              Decimal       @db.Decimal(18, 2)
  method              String
  status              String        @default("PENDING")
  orderCode           BigInt?       @unique
  transactionNo       String?       @unique
  renewalDurationDays Int?
  ptProductId         Int?
  ptProduct           PtProduct?    @relation(fields: [ptProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ptQuantity          Int?
  ptPurchaseMode      String?       @db.VarChar(20)
  ptLevelSnapshot     String?       @db.VarChar(20)
  ptSessionsSnapshot  Int?
  ptDurationDays      Int?
  ptRenewalOptionId   Int?
  ptRenewalOption     PtRenewalOption? @relation(fields: [ptRenewalOptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ptRenewalProductId  Int?
  ptRenewalProduct    PtProduct? @relation("PtRenewalProduct", fields: [ptRenewalProductId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ptRenewalBatchId    Int?
  ptRenewalBatch      PtCreditBatch? @relation("PtBatchRenewals", fields: [ptRenewalBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ptRenewalDays       Int?
  ptRenewalEvent      PtRenewalEvent?
  ptCreditBatches     PtCreditBatch[]
  ptPurchaseItems     PtPurchaseItem[]
  
  staffId             Int?
  staff               User?         @relation("StaffProcessedPayments", fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  consultantId        Int?
  consultant          User?         @relation("ConsultantPayments", fields: [consultantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shiftId             Int?
  shift               StaffShift?   @relation("ShiftPayments", fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  traceRefNo          String?       @db.NVarChar(100)
  cashReceived        Decimal?      @db.Decimal(18, 2)
  cashChange          Decimal?      @db.Decimal(18, 2)
  note                String?       @db.NVarChar(500)
  
  createdAt           DateTime      @default(now())
  paidAt              DateTime?

  @@index([ptRenewalBatchId])
}

// ==========================================
// 8. GIÁO ÁN & TIẾN ĐỘ TẬP LUYỆN (WORKOUT & PROGRESS)
// ==========================================

model WorkoutPlan {
  id          Int      @id @default(autoincrement())
  memberId    Int?
  member      User?    @relation("MemberWorkoutPlans", fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coachId     Int
  coach       User     @relation("CoachCreatedPlans", fields: [coachId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  title       String
  description String?  @db.NVarChar(Max)
  sessionsJson String?  @db.NVarChar(Max)
  mealsJson    String?  @db.NVarChar(Max)
  createdAt   DateTime @default(now())
  studentPlans StudentWorkoutPlan[]
}

model StudentWorkoutPlan {
  id           Int      @id @default(autoincrement())
  workoutPlanId Int?
  workoutPlan  WorkoutPlan? @relation(fields: [workoutPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberId     Int
  member       User     @relation("StudentWorkoutPlanMember", fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coachId      Int
  coach        User     @relation("StudentWorkoutPlanCoach", fields: [coachId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  programName  String   @default("PT") @db.NVarChar(120)
  status       String   @default("ACTIVE") @db.NVarChar(20)
  version      Int      @default(1)
  title        String   @db.NVarChar(200)
  description  String?  @db.NVarChar(Max)
  sessionsJson String   @db.NVarChar(Max)
  mealsJson    String   @db.NVarChar(Max)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
  revisions    WorkoutPlanRevision[]
  exerciseAnalyses ExerciseAnalysis[]

  // The migration adds a filtered UNIQUE index for the ACTIVE row of each
  // (memberId, coachId, programName); Prisma does not model filtered indexes.
  @@index([memberId, coachId, programName, status])
  @@index([coachId, updatedAt])
}

model WorkoutPlanRevision {
  id            Int      @id @default(autoincrement())
  studentPlanId Int
  studentPlan   StudentWorkoutPlan @relation(fields: [studentPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  version       Int
  title         String   @db.NVarChar(200)
  description   String?  @db.NVarChar(Max)
  sessionsJson  String   @db.NVarChar(Max)
  mealsJson     String   @db.NVarChar(Max)
  changedById   Int
  changedBy     User     @relation("WorkoutPlanRevisionEditor", fields: [changedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reason        String   @db.NVarChar(1000)
  createdAt     DateTime @default(now())

  @@unique([studentPlanId, version])
}

model ProgressLog {
  id          Int      @id @default(autoincrement())
  memberId    Int
  member      User     @relation(fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  weight      Float
  bodyFat     Float?
  muscleMass  Float?
  loggedAt    DateTime @default(now())
}

model PtTrainingAssessment {
  id            Int      @id @default(autoincrement())
  memberId      Int
  member        User     @relation("PtAssessmentMember", fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coachId       Int
  coach        User     @relation("PtAssessmentCoach", fields: [coachId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  level         String   @db.VarChar(20)
  kind          String   @db.VarChar(20) // BASELINE | REVIEW
  goal          String?  @db.NVarChar(500)
  movementNotes String?  @db.NVarChar(2000)
  metricName    String?  @db.NVarChar(100)
  metricValue   Float?
  phaseName     String?  @db.NVarChar(100)
  nextSteps     String   @db.NVarChar(2000)
  createdAt     DateTime @default(now())

  @@index([memberId, coachId, level, createdAt])
}

// ==========================================
// 9. ĐÁNH GIÁ, THÔNG BÁO & HỖ TRỢ (REVIEWS, NOTIFS, SUPPORT)
// ==========================================

model Review {
  id             Int          @id @default(autoincrement())
  bookingId      Int          @unique
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  memberId       Int
  member         User         @relation("MemberReviews", fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  coachProfileId Int
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rating         Int          
  comment        String?
  createdAt      DateTime     @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?     
  title     String
  message   String   @db.NVarChar(Max)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SupportRequest {
  id          Int      @id @default(autoincrement())
  memberId    Int
  member      User     @relation("MemberSupport", fields: [memberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  staffId     Int?
  staff       User?    @relation("StaffSupport", fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subject     String
  message     String   @db.NVarChar(Max)
  reply       String?  @db.NVarChar(Max)
  status      String   @default("OPEN") 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActionLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action    String
  details   String?  @db.NVarChar(Max)
  createdAt DateTime @default(now())
}

// ==========================================
// 10. QUẢN LÝ LỄ TÂN & CA TRỰC (STAFF & SHIFTS)
// ==========================================

model DeskDevice {
  id          Int          @id @default(autoincrement())
  deviceToken String       @unique @db.NVarChar(255)
  deviceName  String       @db.NVarChar(100)
  location    String?      @db.NVarChar(255)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  shifts      StaffShift[]
}

model StaffShift {
  id                Int               @id @default(autoincrement())
  shiftCode         String            @unique @db.NVarChar(50)
  staffId           Int
  staff             User              @relation("StaffShifts", fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deskDeviceId      Int?
  deskDevice        DeskDevice?       @relation(fields: [deskDeviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deviceToken       String?           @db.NVarChar(255)

  clockIn           DateTime          @default(now())
  clockOut          DateTime?

  systemCashAmount  Decimal           @default(0) @db.Decimal(18, 2)
  actualCashAmount  Decimal?          @db.Decimal(18, 2)
  differenceAmount  Decimal?          @db.Decimal(18, 2)
  differenceReason  String?           @db.NVarChar(500)

  status            String            @default("OPEN") // OPEN | CLOSED
  notes             String?           @db.NVarChar(500)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  payments          Payment[]         @relation("ShiftPayments")
  checkIns          CheckIn[]         @relation("ShiftCheckIns")
  operationalNotes  OperationalNote[]
}

model OperationalNote {
  id              Int         @id @default(autoincrement())
  staffId         Int
  staff           User        @relation("StaffOperationalNotes", fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  shiftId         Int?
  shift           StaffShift? @relation(fields: [shiftId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  memberId        Int?
  memberName      String?     @db.NVarChar(100)
  memberPhone     String?     @db.NVarChar(20)

  category        String      @db.NVarChar(50) // "HYGIENE", "EQUIPMENT", "SERVICE", "FACILITY", "OTHER"
  content         String      @db.NVarChar(1000)
  priority        String      @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "URGENT"
  status          String      @default("PENDING_REVIEW") // "PENDING_REVIEW", "RESOLVED", "DISMISSED"
  managerFeedback String?     @db.NVarChar(1000)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

