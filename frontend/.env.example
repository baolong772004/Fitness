# ==============================================================================
# AURA FITNESS - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Sao chép file này thành .env và điền các giá trị thực tế của bạn:
#   cp .env.example .env
# ==============================================================================

# Cấu hình ứng dụng
VITE_APP_NAME="AURA FITNESS - Sports Center Management System"
VITE_APP_SHORT_NAME="AuraFitness"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="development"
VITE_APP_BASE_URL="http://localhost:5173"

# Thông tin trung tâm
VITE_CENTER_NAME="AURA FITNESS & YOGA CENTER"
VITE_CENTER_ADDRESS="Số 108 Phố Thể Thao, Quận Cầu Giấy, Hà Nội"
VITE_CENTER_HOTLINE="1900 6868"
VITE_CENTER_SUPPORT_EMAIL="support@aurafitness.vn"
VITE_CENTER_OPERATING_HOURS="05:30 - 22:30 (Thứ 2 - Chủ Nhật)"

# Backend API & WebSocket
VITE_API_BASE_URL="http://localhost:8080/api/v1"
VITE_API_TIMEOUT_MS=15000
VITE_WS_CHECKIN_URL="ws://localhost:8080/ws/checkin"
VITE_ENABLE_MOCK_FALLBACK="true"

# Cổng thanh toán VietQR & MoMo
VITE_VIETQR_BANK_ID="MB"
VITE_VIETQR_ACCOUNT_NO="0988776655"
VITE_VIETQR_ACCOUNT_NAME="CTCP THE THAO AURA FITNESS VIET NAM"
VITE_VIETQR_TEMPLATE="compact2"
VITE_MOMO_PARTNER_CODE="MOMO_DEMO_AURA"
VITE_MOMO_ACCESS_KEY="your_momo_access_key_here"
VITE_MOMO_ENDPOINT="https://test-payment.momo.vn/v2/gateway/api/create"

# Dịch vụ AI (Trợ lý ảo & Tạo giáo án)
VITE_AI_PROVIDER="gemini"
VITE_GEMINI_API_KEY="your_gemini_api_key_here"
VITE_OPENAI_API_KEY="your_openai_api_key_here"
VITE_AI_MODEL_NAME="gemini-1.5-flash"

# Tính năng giao diện
VITE_ENABLE_AUDIO_SYNTHESIS="true"
VITE_MAKEUP_NOTICE_HOURS=4
